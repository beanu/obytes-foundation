# Demo API used by the included networking sample. All EXPO_PUBLIC values are public.
EXPO_PUBLIC_API_URL=https://dummyjson.com/
# Select the app variant explicitly; NODE_ENV is managed by Expo.
EXPO_PUBLIC_APP_ENV=development
# Set these only after linking your own EAS project. Never reuse another app's ID.
# EXPO_ACCOUNT_OWNER=
# EAS_PROJECT_ID=
