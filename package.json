{
  "name": "obytes-foundation",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "xcode": "xed -b ios",
    "doctor": "expo-doctor",
    "preinstall": "npx only-allow bun",
    "start:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview bun run start",
    "prebuild:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 bun run prebuild",
    "prebuild:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 bun run prebuild",
    "android:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview bun run android",
    "ios:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview bun run ios",
    "start:production": "cross-env EXPO_PUBLIC_APP_ENV=production bun run start",
    "prebuild:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 bun run prebuild",
    "android:production": "cross-env EXPO_PUBLIC_APP_ENV=production bun run android",
    "ios:production": "cross-env EXPO_PUBLIC_APP_ENV=production bun run ios",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:development:android": "eas build --profile development --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noemit",
    "lint:translations": "eslint ./src/translations/",
    "test": "jest",
    "check-all": "bun run lint && bun run type-check && bun run test --runInBand && bun run test:tooling",
    "test:ci": "jest --coverage",
    "test:watch": "jest --watch",
    "e2e-test": "node scripts/e2e.mjs",
    "argent:setup": "bunx @swmansion/argent@latest init",
    "check:dependencies": "expo install --check",
    "test:tooling": "node --test scripts/*.node-test.mjs",
    "template:create": "node scripts/create-project.mjs",
    "verify:ios": "node scripts/verify-release.mjs ios",
    "verify:ios:simulator": "node scripts/verify-release.mjs ios-simulator",
    "verify:android": "node scripts/verify-release.mjs android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-form": "^1.27.7",
    "@tanstack/react-query": "^5.90.19",
    "axios": "^1.13.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.4.2",
    "lodash.memoize": "^4.1.2",
    "moti": "^0.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.88.0",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-fetch": "^1.8.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.13.0",
    "react-query-kit": "^3.3.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "uniwind": "^1.2.4",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@dev-plugins/react-query": "^0.4.0",
    "@eslint-react/eslint-plugin": "^2.7.2",
    "@expo/config": "^58.0.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/lodash.memoize": "^4.1.9",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-better-tailwindcss": "^4.0.1",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-testing-library": "^7.15.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "expo-doctor": "^1.21.5",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.6.0",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-nitro-fetch"
        ]
      }
    },
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  },
  "overrides": {
    "zod-validation-error": "^4.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "foundation": {
    "upstream": "https://github.com/obytes/react-native-template-obytes",
    "pullRequest": 543,
    "commit": "43783db5f9ef237cd350f4a6e3535dfffa1454eb"
  }
}
